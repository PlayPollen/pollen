# Cloudflare Pages reads this file from the build output root.
#
# Vite fingerprints every file in /assets/ with a content hash, so a given URL's
# contents can never change — which makes it safe to cache permanently. Without
# this, returning players re-download ~1.5MB of Phaser on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must NOT be cached that way: it's the file that points at the
# current hashed bundle, so a stale copy would pin players to an old build.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
